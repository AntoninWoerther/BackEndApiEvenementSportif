{
  "name": "nodejs-express",
  "version": "1.0.0",
  "description": "Node.js Express application",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "grant:superuser": "tsx src/core/database/seeders/grant-superuser.ts",
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "tsup src/server.ts --format esm,cjs --dts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
